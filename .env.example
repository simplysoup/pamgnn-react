# Payload
PAYLOAD_SECRET=your-secret-here-minimum-32-chars

# Database
# For local development outside Docker, use the direct Postgres connection below.
DATABASE_URL=postgresql://pamgnn:pamgnn@localhost:5432/pamgnn
# For the Compose stack, use:
# DATABASE_URL=postgresql://pamgnn:pamgnn@postgres:5432/pamgnn

# Postgres (used by docker compose)
POSTGRES_USER=pamgnn
POSTGRES_PASSWORD=pamgnn
POSTGRES_DB=pamgnn

# SMTP (Mailhog for local development)
SMTP_HOST=localhost
# For the Compose stack, use:
# SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=hello@pamgraphicdesign.com

# Local bootstrap defaults
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-on-first-login

# Next.js
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
